import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from statsmodels.tsa.arima.model import ARIMA

# 1. Generate simple sample time series data
np.random.seed(42)
dates = pd.date_range(start="2024-01-01", periods=50)
values = np.linspace(10, 30, 50) + np.random.normal(0, 1, 50)
series = pd.Series(values, index=dates)

# 2. Fit an ARIMA model (p=1, d=1, q=1)
model = ARIMA(series, order=(1, 1, 1)).fit()

# 3. Forecast future values (10 steps ahead)
forecast = model.forecast(steps=10)

# 4. Plot historical series and forecast
plt.figure(figsize=(8, 4))
plt.plot(series.index, series, label="Observed", color="blue")
plt.plot(
    forecast.index,
    forecast,
    label="ARIMA Forecast",
    color="red",
    linestyle="--",
    marker="o",
)
plt.title("Time Series Forecasting with ARIMA(1, 1, 1)")
plt.xlabel("Date")
plt.ylabel("Value")
plt.legend()
plt.tight_layout()
plt.show()
