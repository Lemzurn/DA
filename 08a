import matplotlib.pyplot as plt
import numpy as np

# Sample data
x = np.arange(1, 11)
y = x**2
labels = ["Group A", "Group B", "Group C"]
sizes = [40, 35, 25]

fig, axes = plt.subplots(2, 2, figsize=(10, 8))

# 1. Line / Area Plot
axes[0, 0].fill_between(x, y, color="skyblue", alpha=0.5)
axes[0, 0].plot(x, y, color="Slateblue", marker="o")
axes[0, 0].set_title("Area / Line Plot")

# 2. Pie Chart
axes[0, 1].pie(sizes, labels=labels, autopct="%1.1f%%", startangle=90)
axes[0, 1].set_title("Pie Chart")

# 3. Horizontal Bar Chart
axes[1, 0].barh(labels, sizes, color=["teal", "coral", "gold"])
axes[1, 0].set_title("Horizontal Bar Plot")

# 4. Box Plot
box_data = [np.random.normal(0, std, 50) for std in range(1, 4)]
axes[1, 1].boxplot(box_data, patch_artist=True)
axes[1, 1].set_title("Box Plot (Spread Analysis)")

plt.tight_layout()
plt.show()
