import numpy as np
import matplotlib.pyplot as plt

# 1. Pixel Oriented
v = np.random.rand(100)
s = int(np.ceil(np.sqrt(len(v))))
img = np.pad(v, (0, s*s - len(v))).reshape(s, s)

plt.figure(figsize=(5, 5))
plt.imshow(img)
plt.axis('off')
plt.title("Pixel Oriented")
plt.show()

# 2. Geometric (Scatter)
x, y = np.random.rand(2, 50)

plt.figure(figsize=(5, 5))
plt.scatter(x, y)
plt.title("Geometric (Scatter)")
plt.show()

# 3. Icon based (Radar)
samples, feats = 3, 5
data = np.random.rand(samples, feats)
ang = np.linspace(0, 2*np.pi, feats, endpoint=False)
ang = np.append(ang, ang[0])

plt.figure(figsize=(5, 5))
plt.subplot(projection='polar')
for row in data:
    plt.plot(ang, np.append(row, row[0]))
plt.title("Icon based (Radar)")
plt.show()
